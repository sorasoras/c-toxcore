+    ASSERT_TRUE(wait_for_connection(env, alice, alice_conn_id, bob, bob_conn_id, 10000))
+        << "Handshake should succeed after retransmission";
+    EXPECT_TRUE(dropped) << "Filter should have dropped a handshake packet";
