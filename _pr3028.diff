+static const uint8_t tv_handshake_hash[CRYPTO_NOISE_BLAKE2B_HASH_SIZE] = {
+    0x00, 0xe5, 0x1d, 0x2a, 0xac, 0x81, 0xa9, 0xb8,
+    0xeb, 0xe4, 0x41, 0xd6, 0xaf, 0x3e, 0x1c, 0x8e,
